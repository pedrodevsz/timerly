# Neon pooled connection used by the Next.js application runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require"

# Neon direct connection used by Prisma CLI, migrations and seed.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Sessões usam tokens aleatórios opacos; nenhum segredo de sessão é necessário.
# Em produção, conecte o rate limiter de autenticação a Redis/KV compartilhado.
